# Copy to backend/.env for local development. Every value has a sensible default.

APP_ENV=development

# SQLite for development; on Render/Railway set the provided postgres:// URL instead.
DATABASE_URL=sqlite:///./data/mc3d.db
# Uploaded frames and pipeline results. Use a persistent disk in production.
STORAGE_DIR=./data/storage

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_IMAGE_MB=25
MAX_VIDEO_MB=250
MAX_CAMERAS=8
MAX_FRAMES_PER_CAMERA=300
PROCESSING_MAX_DIMENSION=1280
PROCESSING_TIMEOUT_S=600
WORKER_THREADS=2

# Optional: YOLOv8 model exported to ONNX (see docs/models.md). Leave empty to skip detection.
DETECTOR_MODEL_PATH=
DETECTOR_LABELS_PATH=
